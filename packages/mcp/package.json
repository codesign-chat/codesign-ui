{
  "name": "@codesign-ui/mcp",
  "description": "The official MCP server for Codesign UI",
  "version": "1.0.0",
  "main": "dist/stdio.js",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codesign-chat/codesign-ui",
    "directory": "packages/mcp"
  },
  "scripts": {
    "build": "tsup && chmod 755 dist/stdio.js",
    "dev": "tsup --watch",
    "serve": "tsx --watch src/http.ts",
    "inspect": "bun scripts/inspect.js"
  },
  "bin": {
    "codesign-ui-mcp": "./dist/stdio.js"
  },
  "keywords": [
    "codesign-ui",
    "mcp-server",
    "chat",
    "chatgpt",
    "mcp"
  ],
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@types/express": "5.0.6",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "zod": "4.6.5"
  }
}
